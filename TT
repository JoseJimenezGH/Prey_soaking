## ============================================================
## ARRIVAL EVENTS
##
## An arrival is defined as an absence-to-presence transition
## between two consecutive five-minute bins within the same
## file/site.
##
## Transitions across midnight are retained.
##
## The first bin of each site is not counted because its
## preceding state is unknown.
## ============================================================
arrival <- matrix(0L,nrow = nrow(Y_pa),ncol = ncol(Y_pa),dimnames = list(NULL,species_raw))
site_session_id <- interaction(mb_all$site,mb_all$session,drop = TRUE,lex.order = TRUE)
site_indices <- split(seq_len(nrow(mb_all)),site_session_id)
for (idx in site_indices) {
if (length(idx) < 2L) {
next
}
previous_idx <- idx[-length(idx)]
current_idx <- idx[-1L]
time_difference <- as.numeric(difftime(mb_all$bin[current_idx],mb_all$bin[previous_idx],units = "mins"))
consecutive <- (time_difference == bin_min)
previous_state <- Y_pa[previous_idx,,drop = FALSE]
current_state <- Y_pa[current_idx,,drop = FALSE]
arrival[current_idx,] <- 1L * (current_state == 1L & previous_state == 0L & consecutive)
}
stopifnot(all(arrival %in% c(0L,1L)))

