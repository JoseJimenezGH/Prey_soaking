## CREATE BASE PCoA PLOT
## ============================================================
pcoa_species_plot <- ggplot(pcoa_sites_numbered,aes(x = PCoA1,y = PCoA2,colour = lynx,shape = environment)
) +
geom_hline(yintercept = 0,linewidth = 0.3,colour = "grey82"
) +
geom_vline(xintercept = 0,linewidth = 0.3,colour = "grey82"
) +
geom_point(size = 4
) +
ggrepel::geom_text_repel(aes(label = site_label),size = 3.8,box.padding = 0.30,point.padding = 0.15,segment.colour = NA,max.overlaps = Inf,
force = 1.5,seed = 123,show.legend = FALSE
) +
coord_equal(clip = "off"
) +
scale_x_continuous(expand = expansion(mult = c(0.14,0.20))
) +
scale_y_continuous(expand = expansion(mult = c(0.14,0.20))
) +
labs(title = "PCoA of relative arrival composition",x = paste0("PCoA1 (",round(explained_variance[1],1),"%)"),y = paste0("PCoA2 (",
round(explained_variance[2],1),"%)"),colour = "Lynx",shape = "Environment"
) +
theme_classic() +
theme(plot.margin = margin(t = 10,r = 40,b = 10,l = 20))
## ============================================================
## ADD SIGNIFICANT SPECIES VECTORS
## ============================================================
if (nrow(species_vectors_significant) > 0L) {
  ## Calculate a common graphical multiplier
site_x_range <- diff(range(pcoa_sites_numbered$PCoA1,na.rm = TRUE))
site_y_range <- diff(range(pcoa_sites_numbered$PCoA2,na.rm = TRUE))
vector_x_max <- max(abs(species_vectors_significant$PCoA1),na.rm = TRUE)
vector_y_max <- max(abs(species_vectors_significant$PCoA2),na.rm = TRUE)
vector_scale_candidates <- c(if (is.finite(site_x_range) && site_x_range > 0 && is.finite(vector_x_max) && vector_x_max > 0
) {
0.36 * site_x_range / vector_x_max } else { Inf
},
if (is.finite(site_y_range) && site_y_range > 0 && is.finite(vector_y_max) && vector_y_max > 0
) {
0.36 * site_y_range / vector_y_max } else { Inf
}
)
vector_multiplier <- min(vector_scale_candidates)
if (!is.finite(vector_multiplier) || vector_multiplier <= 0
) {
vector_multiplier <- 1
}
  ## Keep statistical and graphical coordinates separate
species_vectors_plot <-
species_vectors_significant |>
mutate(arrow_x = PCoA1 * vector_multiplier,arrow_y = PCoA2 * vector_multiplier,label_x = arrow_x * 1.12,label_y = arrow_y * 1.12)
  ## Add arrows and repelled species labels
pcoa_species_plot <-
pcoa_species_plot +
geom_segment(data = species_vectors_plot,aes(x = 0,y = 0,xend = arrow_x,yend = arrow_y),inherit.aes = FALSE,arrow = grid::arrow(
length = grid::unit(0.16,"cm"),type = "closed"),linewidth = 0.55,colour = "black"
) +
ggrepel::geom_text_repel(data = species_vectors_plot,aes(x = label_x,y = label_y,label = species),inherit.aes = FALSE,colour = "black",
size = 3.4,box.padding = 0.50,point.padding = 0.10,segment.colour = NA,max.overlaps = Inf,force = 4,force_pull = 0.4,seed = 456,
direction = "both"
) +
labs(subtitle = paste0("Species vectors with permutation p ","\u2264 0.05"))
} else {
pcoa_species_plot <-
pcoa_species_plot +
labs(subtitle = paste0("No species vector had permutation p ","\u2264 0.05"))
}
print(pcoa_species_plot)
## ============================================================
## RELATIVE ARRIVAL COMPOSITION BY SITE
## ============================================================
arrival_relative_long <- as.data.frame(arrival_relative
) |>
rownames_to_column("site") |>
pivot_longer(cols = all_of(colnames(arrival_relative)),names_to = "species",values_to = "relative_arrival"
) |>
left_join(
site_metadata_analysis |>
select(site,environment,lynx),by = "site"
) |>
mutate(species = factor(species,levels = colnames(arrival_relative)),site = factor(site,levels = site_metadata_analysis$site))
arrival_composition_site_plot <- ggplot(arrival_relative_long,aes(x = site,y = relative_arrival,fill = species)
) +
geom_col(width = 0.85
) +
facet_grid(environment ~ lynx,scales = "free_x",space = "free_x"
) +
scale_y_continuous(labels = scales::percent_format(accuracy = 1),expand = expansion(mult = c(0,0.02))
) +
labs(title = "Relative arrival composition by site",x = NULL,y = "Relative arrival composition",fill = "Species"
) +
theme_classic() +
theme(axis.text.x = element_text(angle = 45,hjust = 1),panel.spacing.x = unit(1,"lines"))
print(arrival_composition_site_plot)
