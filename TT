## BUILD METADATA FROM DIRECTORY STRUCTURE
## ============================================================
site_metadata <- tibble(file_path = csv_files
) |>
mutate(file = basename(file_path),lynx_folder = basename(dirname(file_path)),environment_folder = basename(dirname(dirname(file_path))),
environment = case_when(environment_folder == "Closed" ~ "Closed",environment_folder == "Open" ~ "Open",TRUE ~ NA_character_),
lynx = case_when(lynx_folder == "Lynx" ~ "Lynx",lynx_folder == "NoLynx" ~ "NoLynx",TRUE ~ NA_character_),
site_base = tools::file_path_sans_ext(file),preliminary_site = paste(environment,lynx,site_base,sep = "_"),
site = make.unique(preliminary_site),environment = factor(environment,levels = c("Closed","Open")),lynx = factor(lynx,levels = c(
"NoLynx","Lynx"))
) |>
arrange(environment,lynx,site
) |>
select(file_path,file,site,environment,lynx)
## ============================================================
## VALIDATE METADATA
## ============================================================
if (any(is.na(site_metadata$environment))) {
stop(paste("Files outside the expected Closed/Open structure:",paste(site_metadata$file_path[is.na(site_metadata$environment)],
collapse = ", ")))
}
if (any(is.na(site_metadata$lynx))) {
stop(paste("Files outside the expected Lynx/NoLynx structure:",paste(site_metadata$file_path[is.na(site_metadata$lynx)],collapse = ", ")))
}
if (anyDuplicated(site_metadata$site)) {
stop("Duplicated site identifiers remained after metadata construction")
}
if (!all(startsWith(site_metadata$file,"summary")
)) {
stop("At least one selected file does not begin exactly with 'summary'")
}
cat("\nSelected site metadata:\n")
print(site_metadata,n = Inf)
## ============================================================
## DESIGN TABLE
## ============================================================
design_table <- site_metadata |>
count(environment,lynx,name = "number_of_sites",.drop = FALSE)
cat("\nNumber of selected files per treatment combination:\n")
print(design_table)
if (any(design_table$number_of_sites == 0L)) {
stop(paste("At least one environment-by-lynx combination","contains no eligible summary files"))
