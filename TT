## ============================================================
## CARRION ARRIVAL COMMUNITY
## FULL-DAY FACTORIAL ANALYSIS
##
## Directory structure:
#
# BData/
# ├── Closed/
# │   ├── Lynx/
# │   │   ├── sitio1.csv
# │   │   └── sitio2.csv
# │   └── NoLynx/
# │       ├── sitio3.csv
# │       └── sitio4.csv
# └── Open/
#     ├── Lynx/
#     │   ├── sitio5.csv
#     │   └── sitio6.csv
#     └── NoLynx/
#         ├── sitio7.csv
#         └── sitio8.csv
#
## Only CSV files whose basename begins exactly with "summary"
## are included.
##
## Main analyses:
## 1. Five-minute temporal bins
## 2. Maximum count per species and temporal bin
## 3. Arrival events defined as absence-to-presence transitions
## 4. Relative arrival composition by file
## 5. Bray-Curtis dissimilarity
## 6. PCoA with Lingoes correction
## 7. NMDS
## 8. Factorial PERMANOVA
## 9. Multivariate dispersion
## ============================================================
setwd("C:/Users/Jose_/OneDrive/03 ProyectoCLM/Analisis seleccionados")
library(tidyverse)
library(lubridate)
library(janitor)
library(vegan)
## ============================================================
## PARAMETERS
## ============================================================
data_directory <- "BData"
sep_char <- ";"
tz_local <- "Europe/Madrid"
bin_min <- 5L
n_permutations <- 9999L
species_raw <- c("N","L","A","I","U","C","Z","M","J","G","K","O","R","T")
community <- janitor::make_clean_names(species_raw)
stopifnot(length(species_raw) == length(community),!anyDuplicated(community))
maximum_failed_datetime_fraction <- 0.01
maximum_failed_datetime_examples <- 20L
## Set to TRUE only if month-day-year dates are known to occur
allow_month_first_dates <- FALSE
## ============================================================
## CHECK DATA DIRECTORY
## ============================================================
if (!dir.exists(data_directory)) {
stop(paste("Data directory not found:",data_directory))
}
## ============================================================
## FIND ALL CSV FILES
## ============================================================
all_csv_files <- list.files(path = data_directory,pattern = "\\.csv$",recursive = TRUE,full.names = TRUE,ignore.case = TRUE)
if (length(all_csv_files) == 0L) {
stop(paste("No CSV files were found in",data_directory))
}
all_csv_files <- normalizePath(all_csv_files,winslash = "/",mustWork = TRUE)
## ============================================================
## SELECT ONLY FILES BEGINNING EXACTLY WITH "summary"
## ============================================================
eligible <- startsWith(basename(all_csv_files),"summary")
csv_files <- all_csv_files[eligible]
excluded_csv_files <- all_csv_files[!eligible]
if (length(csv_files) == 0L) {
stop(paste("No CSV files whose basename begins exactly with","'summary' were found in",data_directory))
}
## Final strict validation
stopifnot(all(startsWith(basename(csv_files),"summary")))
cat("\nNumber of CSV files found:",length(all_csv_files),"\n")
cat("Number of eligible summary files:",length(csv_files),"\n")
cat("\nFiles selected for analysis:\n")
print(csv_files)
cat("\nCSV files excluded from analysis:\n")
if (length(excluded_csv_files) == 0L) {
cat("None\n")
} else {
print(excluded_csv_files)
}
