}
## ============================================================
## STRICT RECORD-LEVEL MULTI-FORMAT DATETIME PARSER
##
## Exact formats are used to prevent flexible parsing from
## changing the year or confusing minutes with seconds.
## ============================================================
parse_datetime_multiformat <- function(x,tz,allow_month_first = FALSE
) {
raw_value <- as.character(x)
clean_value <- trimws(raw_value)
clean_value[toupper(clean_value) %in% c("","NA","N/A","NULL","NAN","NONE","-")] <- NA_character_
clean_value <- stringr::str_replace_all(clean_value,"\u00A0"," ")
clean_value <- stringr::str_squish(clean_value)
clean_value <- stringr::str_replace(clean_value,"^['\"]+","")
clean_value <- stringr::str_replace(clean_value,"['\"]+$","")
  ## ----------------------------------------------------------
  ## Insert missing separator between date and time
  ##
  ## Example:
  ## 2025-10-0822:49:00
  ## becomes:
  ## 2025-10-08 22:49:00
  ## ----------------------------------------------------------
clean_value <- stringr::str_replace(clean_value,pattern = paste0("^(\\d{4}[-/.]\\d{1,2}[-/.]\\d{1,2})","(\\d{1,2}:\\d{2}(?::\\d{2})?)$"),
replacement = "\\1 \\2")
datetime <- rep(as.POSIXct(NA,tz = tz),length(clean_value))
parser_used <- rep(NA_character_,length(clean_value))
  ## ----------------------------------------------------------
  ## Helper for exact parsing
  ## ----------------------------------------------------------
parse_exact_subset <- function(pattern,format_string,parser_name
) {
indices <- which(!is.na(clean_value) & is.na(datetime) & stringr::str_detect(clean_value,pattern))
if (length(indices) == 0L) {
return(invisible(NULL))
}
parsed_values <- suppressWarnings(as.POSIXct(strptime(clean_value[indices],format = format_string,tz = tz)))
successful <- !is.na(parsed_values)
if (any(successful)) {
resolved_indices <- indices[successful]
datetime[resolved_indices] <<-
parsed_values[successful]
parser_used[resolved_indices] <<-
parser_name
}
invisible(NULL)
}
  ## ----------------------------------------------------------
  ## Normalize ISO T separator and terminal Z
  ## ----------------------------------------------------------
iso_t_indices <- which(!is.na(clean_value) & stringr::str_detect(clean_value,"^\\d{4}[-/.]\\d{1,2}[-/.]\\d{1,2}T"))
if (length(iso_t_indices) > 0L) {
clean_value[iso_t_indices] <-
clean_value[iso_t_indices] |>
stringr::str_replace("T"," "
) |>
stringr::str_replace("Z$","")
}
  ## ----------------------------------------------------------
  ## Year-month-day with seconds
  ##
  ## Example: 2024-11-12 01:58:23
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{4}-\\d{1,2}-\\d{1,2} ","\\d{1,2}:\\d{2}:\\d{2}$"),format_string = "%Y-%m-%d %H:%M:%S",
parser_name = "ymd_hms")
  ## ----------------------------------------------------------
  ## Year-month-day without seconds
  ##
  ## Example: 2024-11-12 01:58
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{4}-\\d{1,2}-\\d{1,2} ","\\d{1,2}:\\d{2}$"),format_string = "%Y-%m-%d %H:%M",parser_name = "ymd_hm")
  ## ----------------------------------------------------------
  ## Year-month-day without time
  ## ----------------------------------------------------------
parse_exact_subset(pattern = "^\\d{4}-\\d{1,2}-\\d{1,2}$",format_string = "%Y-%m-%d",parser_name = "ymd")
  ## ----------------------------------------------------------
  ## Year/month/day with seconds
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{4}/\\d{1,2}/\\d{1,2} ","\\d{1,2}:\\d{2}:\\d{2}$"),format_string = "%Y/%m/%d %H:%M:%S",
parser_name = "ymd_slash_hms")
  ## ----------------------------------------------------------
  ## Year/month/day without seconds
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{4}/\\d{1,2}/\\d{1,2} ","\\d{1,2}:\\d{2}$"),format_string = "%Y/%m/%d %H:%M",
parser_name = "ymd_slash_hm")
  ## ----------------------------------------------------------
  ## Day/month/year with seconds
  ##
  ## Example: 21/11/2024 00:10:23
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{1,2}/\\d{1,2}/\\d{4} ","\\d{1,2}:\\d{2}:\\d{2}$"),format_string = "%d/%m/%Y %H:%M:%S",
parser_name = "dmy_hms")
  ## ----------------------------------------------------------
  ## Day/month/year without seconds
  ##
  ## Example: 21/11/2024 0:04
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{1,2}/\\d{1,2}/\\d{4} ","\\d{1,2}:\\d{2}$"),format_string = "%d/%m/%Y %H:%M",parser_name = "dmy_hm")
  ## ----------------------------------------------------------
  ## Day/month/year without time
  ## ----------------------------------------------------------
parse_exact_subset(pattern = "^\\d{1,2}/\\d{1,2}/\\d{4}$",format_string = "%d/%m/%Y",parser_name = "dmy")
  ## ----------------------------------------------------------
  ## Day-month-year with seconds
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{1,2}-\\d{1,2}-\\d{4} ","\\d{1,2}:\\d{2}:\\d{2}$"),format_string = "%d-%m-%Y %H:%M:%S",
parser_name = "dmy_dash_hms")
  ## ----------------------------------------------------------
  ## Day-month-year without seconds
  ## ----------------------------------------------------------
parse_exact_subset(pattern = paste0("^\\d{1,2}-\\d{1,2}-\\d{4} ","\\d{1,2}:\\d{2}$"),format_string = "%d-%m-%Y %H:%M",
parser_name = "dmy_dash_hm")
  ## ----------------------------------------------------------
  ## Optional month-first formats
  ## ----------------------------------------------------------
if (allow_month_first) {
parse_exact_subset(pattern = paste0("^\\d{1,2}/\\d{1,2}/\\d{4} ","\\d{1,2}:\\d{2}:\\d{2}$"),format_string = "%m/%d/%Y %H:%M:%S",
parser_name = "mdy_hms")
parse_exact_subset(pattern = paste0("^\\d{1,2}/\\d{1,2}/\\d{4} ","\\d{1,2}:\\d{2}$"),format_string = "%m/%d/%Y %H:%M",parser_name = "mdy_hm"
)
}
  ## ----------------------------------------------------------
  ## Text-month fallback
  ## ----------------------------------------------------------
text_month_indices <- which(!is.na(clean_value) & is.na(datetime) & stringr::str_detect(clean_value,"[A-Za-z]"))
if (length(text_month_indices) > 0L) {
parsed_values <- suppressWarnings(lubridate::parse_date_time(clean_value[text_month_indices],orders = c("dbY HMS","dbY HM","dbY"),tz = tz,
exact = TRUE,quiet = TRUE))
successful <- !is.na(parsed_values)
if (any(successful)) {
resolved_indices <- text_month_indices[successful]
datetime[resolved_indices] <-
parsed_values[successful]
parser_used[resolved_indices] <-
"text_month"
}
}
  ## ----------------------------------------------------------
  ## Final classification
  ## ----------------------------------------------------------
parser_used[is.na(clean_value)] <- "missing_input"
parser_used[!is.na(clean_value) & is.na(datetime)] <- "failed"
result <- tibble(datetime_original = raw_value,datetime_clean = clean_value,datetime = datetime,datetime_parser = parser_used,
datetime_failed = (!is.na(clean_value) & is.na(datetime)))
return(result)
}
## ============================================================
## PROCESS ONE SUMMARY FILE
## ============================================================
process_summary <- function(csv_path,site_id,community_columns) {
  ## ----------------------------------------------------------
  ## Verify eligible filename
  ## ----------------------------------------------------------
  if (!startsWith(basename(csv_path),"summary")) {
  stop(paste("Ineligible file passed to process_summary:",csv_path))
  }
  ## ----------------------------------------------------------
  ## Read data
  ## ----------------------------------------------------------
  df_raw <- read.csv(csv_path,sep = sep_char,stringsAsFactors = FALSE,check.names = FALSE
  ) |>
  clean_names()
  if (!"datetime" %in% names(df_raw)) {
  stop(paste("The datetime column is missing in",csv_path))
  }
  total_rows <- nrow(df_raw)
  if (total_rows == 0L) {
  stop(paste("The input file contains no rows:",csv_path))
  }
  ## ----------------------------------------------------------
  ## Add missing species columns
  ## ----------------------------------------------------------
  missing_species <- setdiff(community_columns,names(df_raw))
  if (length(missing_species) > 0L) {
    message(paste("Site:",site_id,"| species columns filled with zero:",paste(missing_species,collapse = ", ")))
    for (sp in missing_species) {
      df_raw[[sp]] <- 0
   }
  }
  ## ----------------------------------------------------------
  ## Keep columns in a consistent order
  ## ----------------------------------------------------------
  df_raw <- df_raw |>
  select(datetime,all_of(community_columns),everything())
  ## ----------------------------------------------------------
  ## Parse datetime
  ## ----------------------------------------------------------
  datetime_result <- parse_datetime_multiformat(x = df_raw$datetime,tz = tz_local,allow_month_first = allow_month_first_dates)
  required_parser_columns <- c("datetime_original","datetime_clean","datetime","datetime_parser","datetime_failed")
  if (nrow(datetime_result) != total_rows || !all(required_parser_columns %in% names(datetime_result))
  ) {
  stop(paste("Unexpected datetime parser output in",csv_path))
  }
  df_raw <- bind_cols(
  df_raw |>
  select(-datetime),datetime_result)
  ## ----------------------------------------------------------
  ## Datetime parsing diagnostics
  ## ----------------------------------------------------------
  failed_datetimes <- sum(df_raw$datetime_failed,na.rm = TRUE)
  missing_datetime_inputs <- sum(df_raw$datetime_parser == "missing_input",na.rm = TRUE)
  non_missing_datetime_inputs <- sum(df_raw$datetime_parser != "missing_input",na.rm = TRUE)
  parsed_datetimes <- sum(!is.na(df_raw$datetime))
  failed_datetime_fraction <- if (non_missing_datetime_inputs > 0L
  ) {
  failed_datetimes /
  non_missing_datetime_inputs
  } else {
  NA_real_
  }
  ## ----------------------------------------------------------
  ## Check datetime row classification
  ## ----------------------------------------------------------
  classified_rows <- (
  parsed_datetimes +
  failed_datetimes +
  missing_datetime_inputs)
  if (classified_rows != total_rows) {
  stop(paste("Datetime row classification is inconsistent in",csv_path,"| total rows:",total_rows,"| classified rows:",classified_rows))
  }
  if (any(is.na(df_raw$datetime_parser))) {
  stop(paste("Unclassified datetime records remained in",csv_path))
  }
  cat("\nSite:",site_id,"\n","File:",basename(csv_path),"\n","Total source rows:",total_rows,"\n",
  "Missing datetime inputs:",missing_datetime_inputs,"\n","Successfully parsed datetimes:",parsed_datetimes,"\n",
  "Failed non-missing datetimes:",failed_datetimes,"\n","Failed datetime percentage:",ifelse(is.finite(failed_datetime_fraction),round(
  100 * failed_datetime_fraction,3),NA_real_),"%\n")
  ## ----------------------------------------------------------
  ## Parser frequency summary
  ## ----------------------------------------------------------
  parser_summary_current <- df_raw |>
  count(datetime_parser,name = "number_of_rows"
  ) |>
  mutate(site = site_id,file = basename(csv_path),proportion = number_of_rows / sum(number_of_rows)
  ) |>
  select(site,file,datetime_parser,number_of_rows,proportion)
  cat("\nDatetime parser summary:\n")
  base::print.data.frame(as.data.frame(parser_summary_current),row.names = FALSE,na.print = "NA")
  ## ----------------------------------------------------------
  ## Extract unresolved datetime records
  ## ----------------------------------------------------------
  failed_datetime_rows <- df_raw |>
  filter(datetime_failed)
  if (failed_datetimes > 0L) {
  failed_examples <- failed_datetime_rows |>
  count(datetime_original,datetime_clean,sort = TRUE,name = "number_of_rows"
  ) |>
  slice_head(n = maximum_failed_datetime_examples)
  cat("\nUnparsed datetime examples for",site_id,":\n")
  base::print.data.frame(as.data.frame(failed_examples),row.names = FALSE,na.print = "NA")
  warning(paste0("Datetime parsing failed for ",failed_datetimes," rows in ",basename(csv_path)," (",round(100 * failed_datetime_fraction,3
  ),"% of non-missing datetime inputs)."))
  }
  ## ----------------------------------------------------------
  ## Enforce parsing failure threshold
  ## ----------------------------------------------------------
  if (is.finite(failed_datetime_fraction) && failed_datetime_fraction > maximum_failed_datetime_fraction
  ) {
  stop(paste0("Datetime failure rate exceeded ",100 * maximum_failed_datetime_fraction,"% in ",basename(csv_path),
  ". Inspect the unparsed datetime examples above."))
  }
  ## ----------------------------------------------------------
  ## Remove rows without a valid datetime
  ## ----------------------------------------------------------
  df_raw <- df_raw |>
  filter(!is.na(datetime))
  valid_source_rows <- nrow(df_raw)
  if (valid_source_rows == 0L) {
  stop(paste("No valid datetime values remained in",csv_path))
  }
  ## ----------------------------------------------------------
  ## Convert species columns to numeric
  ## ----------------------------------------------------------
  df_raw <- df_raw |>
  mutate(across(all_of(community_columns),~suppressWarnings(as.numeric(as.character(.x)))))
  species_na <- colSums(is.na(df_raw[,community_columns,drop = FALSE]))
  if (any(species_na > 0L)) {
  warning(paste("Missing or non-numeric species values replaced with zero in",basename(csv_path),":",paste(names(species_na)[species_na > 0L],
  species_na[species_na > 0L],sep = "=",collapse = ", ")))
  }
  df_raw <- df_raw |>
  mutate(across(all_of(community_columns),~replace_na(.x,0)))
  community_matrix_raw <- as.matrix(df_raw[,community_columns,drop = FALSE])
  storage.mode(community_matrix_raw) <- "numeric"
  if (any(!is.finite(community_matrix_raw))) {
  stop(paste("Non-finite species values remained in",csv_path))
  }
  if (any(community_matrix_raw < 0)) {
  stop(paste("Negative species values detected in",csv_path))
  }
  ## ----------------------------------------------------------
  ## Temporal binning
  ##
  ## The maximum value per species is retained within every
  ## five-minute bin.
  ## ----------------------------------------------------------
  interval_string <- paste(bin_min,"min")
  mb_observed <- df_raw |>
  mutate(bin = floor_date(datetime,unit = interval_string)
  ) |>
  group_by(bin) |>
  summarise(across(all_of(community_columns),~max(.x,na.rm = TRUE)),.groups = "drop"
  ) |>
  arrange(bin)
  if (nrow(mb_observed) == 0L) {
  stop(paste("No temporal bins were generated for",csv_path))
  }
  if (anyDuplicated(mb_observed$bin)) {
  stop(paste("Duplicated temporal bins remained in",csv_path))
  }
  ## ----------------------------------------------------------
  ## Describe the complete temporal range
  ## ----------------------------------------------------------
  parsed_years <- sort(unique(lubridate::year(mb_observed$bin)))
  if (any(is.na(parsed_years))) {
  stop(paste("Missing years remained after datetime parsing in",csv_path))
  }
  first_observed_bin <- min(mb_observed$bin)
  last_observed_bin <- max(mb_observed$bin)
  total_span_days <- as.numeric(difftime(last_observed_bin,first_observed_bin,units = "days"))
  if (!is.finite(total_span_days)) {
  stop(paste("Non-finite temporal span detected in",csv_path))
  }
  cat("Parsed years:",paste(parsed_years,collapse = ", "),"\n","First observed bin:",format(first_observed_bin,"%Y-%m-%d %H:%M:%S"),"\n",
  "Last observed bin:",format(last_observed_bin,"%Y-%m-%d %H:%M:%S"),"\n","Total temporal span:",round(total_span_days,2),"days\n")
  ## ----------------------------------------------------------
  ## Identify monitoring sessions
  ##
  ## A gap longer than maximum_gap_days starts a new session.
  ## ----------------------------------------------------------
  gap_threshold_minutes <- (maximum_gap_days * 24 * 60)
  mb_observed <- mb_observed |>
  mutate(gap_minutes = as.numeric(difftime(bin,lag(bin),units = "mins")),new_session = is.na(gap_minutes) |
  gap_minutes > gap_threshold_minutes,session = cumsum(new_session))
  number_of_sessions <- n_distinct(mb_observed$session)
  temporal_gaps <- mb_observed |>
  filter(!is.na(gap_minutes),gap_minutes > gap_threshold_minutes
  ) |>
  transmute(session,previous_bin = lag(mb_observed$bin)[which(!is.na(mb_observed$gap_minutes) & mb_observed$gap_minutes >
  gap_threshold_minutes)],next_bin = bin,gap_minutes,gap_days = gap_minutes / 1440)
  cat("Maximum gap defining a new session:",maximum_gap_days,"days\n","Number of monitoring sessions:",number_of_sessions,"\n")
  if (nrow(temporal_gaps) > 0L) {
  cat("\nTemporal gaps defining new sessions:\n")
  base::print.data.frame(as.data.frame(temporal_gaps),row.names = FALSE,na.print = "NA")
  }
  ## ----------------------------------------------------------
  ## Remove temporary gap variables
  ## ----------------------------------------------------------
  mb_observed <- mb_observed |>
  select(bin,session,all_of(community_columns))
  ## ----------------------------------------------------------
  ## Complete bins separately within every session
  ##
  ## Long gaps between sessions are not filled with zeros.
  ## ----------------------------------------------------------
  mb <- mb_observed |>
  group_split(session) |>
  map_dfr(
  function(session_data) {
  session_id <- unique(session_data$session)
  if (length(session_id) != 1L) {
  stop(paste("Invalid session identifier in",csv_path))
  }
  session_sequence <- seq(from = min(session_data$bin),to = max(session_data$bin),by = interval_string)
  tibble(bin = session_sequence,session = session_id
  ) |>
  left_join(session_data,by = c("bin","session")
  ) |>
  mutate(across(all_of(community_columns),~replace_na(.x,0)))
  }
  ) |>
  mutate(date = as.Date(bin,tz = tz_local),hour = hour(bin),minute = minute(bin),site = site_id
  ) |>
  arrange(session,bin)
  if (nrow(mb) == 0L) {
  stop(paste("No completed temporal bins were generated for",csv_path))
  }
  ## ----------------------------------------------------------
  ## Session diagnostic
  ## ----------------------------------------------------------
  session_diagnostic_current <- mb |>
  group_by(session) |>
  summarise(first_bin = min(bin),last_bin = max(bin),complete_bins = n(),calendar_days = n_distinct(date),duration_days = as.numeric(difftime(
  last_bin,first_bin,units = "days")),.groups = "drop"
  ) |>
  mutate(site = site_id,file = basename(csv_path)
  ) |>
  select(site,file,session,first_bin,last_bin,duration_days,complete_bins,calendar_days)
  total_monitoring_days <- sum(session_diagnostic_current$duration_days)
  cat("\nSession diagnostic:\n")
  base::print.data.frame(as.data.frame(session_diagnostic_current),row.names = FALSE,na.print = "NA")
  cat("\nTotal monitored duration across sessions:",round(total_monitoring_days,2),"days\n")
  ## ----------------------------------------------------------
  ## Final community checks
  ## ----------------------------------------------------------
  if (any(is.na(mb[,community_columns,drop = FALSE])
  )) {
  stop(paste("NA values remained after bin completion in",csv_path))
  }
  if (anyDuplicated(mb[,c("session","bin")]
  )) {
  stop(paste("Duplicated session-bin combinations detected in",csv_path))
  }
  ## ----------------------------------------------------------
  ## Check temporal continuity within each session
  ## ----------------------------------------------------------
  continuity_check <- mb |>
  group_by(session) |>
  arrange(bin,.by_group = TRUE
  ) |>
  mutate(difference_minutes = as.numeric(difftime(bin,lag(bin),units = "mins"))
  ) |>
  ungroup() |>
  filter(!is.na(difference_minutes),difference_minutes != bin_min)
  if (nrow(continuity_check) > 0L) {
  stop(paste("Non-consecutive bins remained within a session in",csv_path))
  }
  ## ----------------------------------------------------------
  ## Processing diagnostic
  ## ----------------------------------------------------------
  processing_diagnostic_current <- tibble(site = site_id,file = basename(csv_path),total_source_rows = total_rows,
  valid_source_rows = valid_source_rows,missing_datetime_inputs = missing_datetime_inputs,failed_datetimes = failed_datetimes,
  failed_datetime_fraction = failed_datetime_fraction,observed_bins = nrow(mb_observed),complete_bins = nrow(mb),
  number_of_sessions = number_of_sessions,first_observed_bin = first_observed_bin,last_observed_bin = last_observed_bin,parsed_years = paste(
  parsed_years,collapse = ", "),total_span_days = total_span_days,monitored_duration_days = total_monitoring_days,
  calendar_days = n_distinct(mb$date))
  cat("\nProcessing result:\n","Site:",site_id,"\n","Valid source rows:",valid_source_rows,"\n","Observed bins:",nrow(mb_observed),"\n",
  "Complete bins across sessions:",nrow(mb),"\n","Monitoring sessions:",number_of_sessions,"\n",
  "Calendar days represented:",n_distinct(mb$date),"\n")
  ## ----------------------------------------------------------
  ## Store diagnostics as attributes
  ## ----------------------------------------------------------
  attr(mb,"datetime_parser_summary") <- parser_summary_current
  attr(mb,"datetime_failed_examples"
  ) <- if (failed_datetimes > 0L) {
  failed_datetime_rows |>
  count(datetime_original,datetime_clean,sort = TRUE,name = "number_of_rows"
  ) |>
  mutate(site = site_id,file = basename(csv_path)
  ) |>
  select(site,file,datetime_original,datetime_clean,number_of_rows)
  } else {
  tibble(site = character(),file = character(),datetime_original = character(),datetime_clean = character(),number_of_rows = integer())
  }
  attr(mb,"datetime_diagnostic") <- tibble(site = site_id,file = basename(csv_path),total_rows = total_rows,non_missing_datetime_inputs =
  non_missing_datetime_inputs,missing_datetime_inputs = missing_datetime_inputs,parsed_datetimes = parsed_datetimes,failed_datetimes =
  failed_datetimes,failed_fraction = failed_datetime_fraction,parsed_years = paste(parsed_years,collapse = ", "),total_span_days =
  total_span_days,number_of_sessions = number_of_sessions,monitored_duration_days = total_monitoring_days)
  attr(mb,"processing_diagnostic") <- processing_diagnostic_current
  attr(mb,"session_diagnostic") <- session_diagnostic_current
  attr(mb,"temporal_gaps") <- temporal_gaps
  return(mb)
}

